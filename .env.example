# Preenchido automaticamente pelo Lovable ao conectar o Supabase externo (Settings → External Supabase).
# Use somente a chave pública (publishable). Nunca exponha a service_role key no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA_SUPABASE
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO
